# Postgres connection string (Neon/Vercel Postgres/Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/milestone?sslmode=require"

# Session signing
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_SESSION_SECRET="change-me-to-a-different-long-random-string"

# Public URL of this API (used for OAuth redirect URIs)
API_BASE_URL="http://localhost:4000"
# Origin(s) allowed to call the API (extension origin, comma-separated)
CORS_ORIGINS="chrome-extension://REPLACE_WITH_EXTENSION_ID"

# Discord OAuth (Developer Portal -> your application)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="change-me"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_VERIFIED_PRICE_ID=""

# Seed data (initial superadmin, created by `npm run prisma:seed`)
SEED_ADMIN_EMAIL="admin@milestone.app"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
