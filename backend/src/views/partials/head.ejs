<meta charset="utf-8" />
<title><%= title %> — Milestone Admin</title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto; background: #0a0b12; color: #f5f5f7; }
  header { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; border-bottom: 1px solid rgba(255,255,255,.12); }
  header a { color: #fff; text-decoration: none; font-weight: 700; }
  main { max-width: 980px; margin: 0 auto; padding: 24px; display: grid; gap: 24px; }
  section { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.12); border-radius: 14px; padding: 18px; }
  h2 { margin-top: 0; font-size: 15px; text-transform: uppercase; letter-spacing: .08em; color: #9aa0b3; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid rgba(255,255,255,.08); vertical-align: top; }
  form.inline { display: inline; }
  form.stack { display: grid; gap: 8px; max-width: 420px; }
  input, select, textarea { padding: 8px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.18); background: #12141f; color: #fff; }
  button { cursor: pointer; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: linear-gradient(90deg,#6D28D9,#7C3AED); color: #fff; font-weight: 700; }
  button.ghost { background: rgba(255,255,255,.08); }
  button.danger { background: rgba(239,68,68,.25); }
  .error { color: #f87171; }
  .muted { color: #9aa0b3; font-size: 13px; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; border: 1px solid rgba(255,255,255,.15); font-size: 12px; }
  a.link { color: #a78bfa; }
</style>
